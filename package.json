{
  "name": "krano",
  "version": "0.4.3",
  "private": true,
  "description": "KRANO — plataforma open source de ofertas, vídeos e funis autohospedada na Cloudflare.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/cli"
  ],
  "bin": {
    "krano": "./packages/cli/bin/funnel-zero.mjs",
    "funnel-zero": "./packages/cli/bin/funnel-zero.mjs"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:worker": "wrangler dev --local",
    "setup": "node ./packages/cli/bin/funnel-zero.mjs setup",
    "prebuild": "wrangler types",
    "build": "tsc -b && vite build",
    "pretypecheck": "wrangler types",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cf:types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply krano-development-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply krano-development-db --remote",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "deploy:dev": "npm run build && wrangler deploy --minify",
    "check:startup": "wrangler check startup",
    "backup": "node ./scripts/backup.mjs",
    "restore": "node ./scripts/restore.mjs",
    "uninstall": "node ./scripts/uninstall.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@xyflow/react": "^12.8.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260726.1",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
