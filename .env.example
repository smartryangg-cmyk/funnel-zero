# Apenas para desenvolvimento local. Nunca commite valores reais.
SESSION_SECRET=gere-um-segredo-de-32-bytes
SETUP_TOKEN_HASH=hash-do-token-temporario
FREE_ONLY=true

# OAuth é opcional. Clones do GitHub usam a conexão guiada por token oficial.
# Configure um cliente público apenas se quiser a experiência OAuth sem copiar token.
CLOUDFLARE_OAUTH_CLIENT_ID=cliente-oauth-publico
